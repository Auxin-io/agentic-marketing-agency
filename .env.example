# Required API Keys
OPENAI_API_KEY=your_openai_api_key_here
EXA_API_KEY=your_exa_api_key_here

# Email Configuration (SMTP)
# For Gmail: Use smtp.gmail.com with port 587
# You may need to create an "App Password" in your Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email_address_here
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Marketing Agency

# Optional: Email recipient for lead reports
# If not set, emails will be sent to SMTP_USER
#LEAD_REPORT_EMAIL=sales@yourcompany.com
LEAD_REPORT_EMAIL=your_email_address_here

# Optional: set to 1 to run the pipeline without sending any email.
# The CSV export is still written to output/.
#DISABLE_EMAIL=1

# Optional: override the model used by every agent (default: openai/gpt-4o-mini)
#OPENAI_MODEL=openai/gpt-4o-mini

# Optional: override where CSV exports are written (default: ./output)
#LEAD_OUTPUT_DIR=

# --- Security controls -------------------------------------------------
# Egress policy: who may receive the lead report. Comma-separated addresses
# and/or @domain suffixes. UNSET means no allowlist, and every send still
# falls through to human approval.
#LEAD_EMAIL_ALLOWLIST=@yourcompany.com,sales@partner.com

# How long the human-approval gate waits before failing closed (denying).
#APPROVAL_TIMEOUT_MS=120000
